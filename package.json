{
  "name": "osanpo-club-tokyo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "overrides": {
    "playwright-core": "1.61.1"
  },
  "scripts": {
    "dev": "next dev",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "validate:content": "node --import tsx scripts/validate-content.ts",
    "test": "vitest run",
    "build": "node scripts/build.mjs",
    "serve:out": "node scripts/serve-out.mjs",
    "test:e2e": "node scripts/prepare-chromium.mjs && playwright test",
    "test:a11y": "node scripts/prepare-chromium.mjs && playwright test tests/e2e/a11y.spec.ts",
    "test:links": "node scripts/check-links.mjs",
    "test:seo": "node scripts/check-seo.mjs",
    "test:security": "node scripts/check-security.mjs",
    "test:lighthouse": "node scripts/clean-lighthouse.mjs && node scripts/prepare-chromium.mjs && lhci autorun",
    "test:all": "npm run lint && npm run typecheck && npm run validate:content && npm run test && npm run build && npm run test:links && npm run test:seo && npm run test:security && npm run test:e2e && npm run test:lighthouse"
  },
  "dependencies": {
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.61.1",
    "@sparticuz/chromium": "149.0.0",
    "@types/node": "26.1.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.12",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
